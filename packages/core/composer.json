{
    "name": "ladcms/core",
    "description": "LADCMS core: users, roles, admin, module system",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "composer/semver": "^3.4",
        "illuminate/contracts": "^13.0",
        "inertiajs/inertia-laravel": "^3.0",
        "spatie/laravel-package-tools": "^1.92",
        "spatie/laravel-permission": "^8.0",
        "spatie/laravel-settings": "^3.9"
    },
    "autoload": {
        "psr-4": { "Ladcms\\Core\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "Ladcms\\Core\\Tests\\": "tests/" }
    },
    "extra": {
        "laravel": {
            "providers": ["Ladcms\\Core\\CoreServiceProvider"]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
